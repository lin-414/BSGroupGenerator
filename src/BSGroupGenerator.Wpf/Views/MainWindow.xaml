<Window x:Class="BSGroupGenerator.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="780" Width="1160" MinHeight="660" MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        Background="{DynamicResource B.Window}" FontFamily="{StaticResource AppFont}" FontSize="13"
        AllowDrop="True">
    <Window.InputBindings>
        <KeyBinding Modifiers="Control" Key="S" Command="{Binding SaveAsyncCommand}" />
        <KeyBinding Modifiers="Control" Key="Z" Command="{Binding UndoCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <!-- 根用 Grid 包住整窗内容：扫描遮罩作为最后一个子元素盖在全窗口之上 -->
    <Grid>
        <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{DynamicResource L.Menu_Tools}">
                <MenuItem Header="{DynamicResource L.Menu_Diagnostics}" Click="Diagnostics_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource L.Menu_CleanupStale}" Command="{Binding CleanupStaleMembersCommand}" />
                <MenuItem Header="{DynamicResource L.Menu_RulePresets}" Click="RulePresets_Click" />
            </MenuItem>
            <!-- 主题与语言提到顶层：点一下菜单栏即展开，不必先进「设置」 -->
            <MenuItem Header="{DynamicResource L.Menu_Theme}">
                <MenuItem x:Name="MiThemeBoutique" Header="{DynamicResource L.Theme_Dark}" Tag="boutique"
                          IsCheckable="True" Click="Theme_Click" />
                <MenuItem x:Name="MiThemeLight" Header="{DynamicResource L.Theme_Light}" Tag="light"
                          IsCheckable="True" Click="Theme_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource L.Menu_Language}">
                <MenuItem x:Name="MiLangZh" Header="中文" Tag="zh" IsCheckable="True" Click="Lang_Click" />
                <MenuItem x:Name="MiLangEn" Header="English" Tag="en" IsCheckable="True" Click="Lang_Click" />
            </MenuItem>
            <MenuItem Header="{DynamicResource L.Menu_Settings}">
                <MenuItem Header="{DynamicResource L.Menu_CheckUpdate}" Click="CheckUpdate_Click" />
                <MenuItem Header="{DynamicResource L.Menu_Help}" Click="Help_Click" />
                <MenuItem Header="{DynamicResource L.Menu_About}" Click="About_Click" />
                <Separator />
                <MenuItem Header="{DynamicResource L.Menu_Exit}" Click="Exit_Click" />
            </MenuItem>
        </Menu>

        <!-- 顶部设置区 -->
        <Grid DockPanel.Dock="Top" Margin="12,8,12,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <Style x:Key="RowLabel" TargetType="TextBlock">
                    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                    <Setter Property="VerticalAlignment" Value="Center" />
                    <Setter Property="Margin" Value="0,0,10,0" />
                </Style>
                <Style x:Key="FieldCombo" TargetType="ComboBox"
                       BasedOn="{StaticResource {x:Type ComboBox}}">
                    <Setter Property="Height" Value="30" />
                    <Setter Property="Margin" Value="0,3" />
                    <Setter Property="VerticalContentAlignment" Value="Center" />
                </Style>
            </Grid.Resources>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource L.Main_Instance}" Style="{StaticResource RowLabel}" />
            <ComboBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FieldCombo}"
                      ItemsSource="{Binding Instances}" SelectedItem="{Binding SelectedInstance}"
                      DisplayMemberPath="DisplayName" />
            <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{DynamicResource L.Main_Refresh}" Command="{Binding RefreshInstancesCommand}" MinWidth="90" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button Content="{DynamicResource L.Main_AddMo2Dir}" Click="AddMo2_Click" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource L.Main_Profile}" Style="{StaticResource RowLabel}" />
            <ComboBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FieldCombo}"
                      ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource L.Main_BodySlide}" Style="{StaticResource RowLabel}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Style="{StaticResource FieldCombo}"
                      ItemsSource="{Binding BodySlideDirs}" SelectedItem="{Binding SelectedBodySlide}" />
            <StackPanel Grid.Row="2" Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Content="{DynamicResource L.Main_Detect}" Command="{Binding DetectBodySlideCommand}" MinWidth="90" Margin="0,0,8,0" VerticalAlignment="Center" />
                <Button Content="{DynamicResource L.Main_Browse}" Click="BrowseBodySlide_Click" MinWidth="90" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource L.Main_Output}" Style="{StaticResource RowLabel}" />
            <!-- 浏览… 跟在下拉框右侧，而不是孤悬在第三列，设置区少占一行 -->
            <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                <ComboBox Style="{StaticResource FieldCombo}" Width="200"
                          ItemsSource="{Binding WriteModes}" SelectedItem="{Binding SelectedWriteMode}"
                          DisplayMemberPath="Label" />
                <Button Content="{DynamicResource L.Main_Browse}" Command="{Binding BrowseForTargetCommand}" MinWidth="90"
                        Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Text="{Binding InfoLine}"
                       Foreground="{DynamicResource B.TextDim}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </Grid>

        <!-- 底部固定区先入栈（状态栏最底 → 日志 → 保存按钮），主分栏作为 DockPanel 填充子元素兜住剩余空间，
             避免默认窗口高度下这些区域被树内容挤出窗口 -->
        <!-- StatusBar 默认主题样式会显式设前景色盖过窗口继承，须再指回主题文字色 -->
        <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.BorderSoft}"
                   Foreground="{DynamicResource B.Text}" BorderThickness="0,1,0,0">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusCounts}" />
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="OutputLink" Text="{Binding OutputText}" Foreground="{DynamicResource B.AccentText}"
                           MouseLeftButtonUp="Output_Click" Cursor="Hand" />
            </StatusBarItem>
        </StatusBar>

        <!-- 日志 -->
        <TextBox DockPanel.Dock="Bottom" Height="96" Margin="12,0,12,4"
                 Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                 x:Name="LogBox" />

        <Button DockPanel.Dock="Bottom" Content="{DynamicResource L.Main_Save}" Height="34" MinWidth="160" Margin="12,6,12,4"
                Command="{Binding SaveAsyncCommand}" HorizontalAlignment="Right">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDirty}" Value="True">
                            <Setter Property="Background" Value="#E8A33A" />
                            <Setter Property="ToolTip" Value="{DynamicResource L.Main_SaveDirtyTip}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- 主分栏（DockPanel 最后的填充子元素） -->
        <Grid Margin="12,4,12,4" MinHeight="300">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左：模组树 -->
            <DockPanel Grid.Column="0">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0">
                        <TextBox x:Name="FilterBox" Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=0}" />
                        <TextBlock Text="{DynamicResource L.Main_FilterOutfits}" IsHitTestVisible="False" Foreground="{DynamicResource B.TextDim}"
                                   Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=FilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Grid Grid.Column="2">
                        <TextBox x:Name="ModFilterBox" Text="{Binding ModFilterText, UpdateSourceTrigger=PropertyChanged, Delay=0}" />
                        <TextBlock Text="{DynamicResource L.Main_FilterMods}" IsHitTestVisible="False" Foreground="{DynamicResource B.TextDim}"
                                   Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=ModFilterBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <CheckBox Grid.Column="3" Content="{DynamicResource L.Main_UnassignedOnly}" Margin="10,0,0,0"
                              VerticalAlignment="Center" IsChecked="{Binding UnassignedOnly}" />
                </Grid>
                <TreeView ItemsSource="{Binding TreeRoots}">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                          VerticalAlignment="Center" Margin="0,0,5,0">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                                <TextBlock Text="{Binding Text}" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMember}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.Member}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.Conflict}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                                                    <Setter Property="FontWeight" Value="Bold" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- 右：分组面板 -->
            <DockPanel Grid.Column="2" Margin="6,0,0,0">
                <TextBlock DockPanel.Dock="Top" FontWeight="Bold" Margin="0,0,0,6"
                           Foreground="{DynamicResource B.Navy}"
                           Text="{DynamicResource L.Main_GroupsHeader}" />
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding GroupInfo}"
                           Foreground="{DynamicResource B.TextDim}" Margin="0,6,0,0" />
                <!-- 成员操作行：加入当前组是本面板主操作，占双列宽并用主题色强调；导入并入同排，省一行高度 -->
                <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="{DynamicResource L.Main_AddToGroup}"
                            Command="{Binding ApplyCheckedToCurrentGroupCommand}" CommandParameter="add"
                            Margin="0,0,6,0" Style="{StaticResource PrimaryButton}" />
                    <Button Grid.Column="1" Content="{DynamicResource L.Main_RemoveFromGroup}"
                            Command="{Binding ApplyCheckedToCurrentGroupCommand}" CommandParameter="remove"
                            Margin="0,0,6,0" />
                    <Button Grid.Column="2" Content="{DynamicResource L.Main_Undo}" Command="{Binding UndoCommand}" Margin="0,0,6,0" />
                    <Button Grid.Column="3" Content="{DynamicResource L.Main_ImportGroups}" Click="Import_Click" />
                </Grid>
                <UniformGrid DockPanel.Dock="Bottom" Columns="5" Margin="0,8,0,0">
                    <Button Content="{DynamicResource L.Main_NewGroup}" Click="NewGroup_Click" Margin="0,0,6,0" />
                    <Button Content="{DynamicResource L.Main_Rename}" Click="RenameGroup_Click" Margin="0,0,6,0" />
                    <Button Content="{DynamicResource L.Main_DeleteGroup}" Click="DeleteGroup_Click" Margin="0,0,6,0" />
                    <Button Content="{DynamicResource L.Main_ViewGroup}" Click="ViewMembers_Click" Margin="0,0,6,0" />
                    <Button Content="{DynamicResource L.Main_RuleGrouping}" Click="Rules_Click" />
                </UniformGrid>
                <ListBox ItemsSource="{Binding Groups}" SelectedIndex="{Binding SelectedGroupIndex}"
                         BorderBrush="{DynamicResource B.Border}" BorderThickness="1"
                         VirtualizingPanel.IsVirtualizing="True"
                         MouseDoubleClick="Groups_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Padding="4,2" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Grid>
        </DockPanel>

        <!-- 扫描进度遮罩：BodySlide 探测/服装扫描期间盖住全窗口并拦截点击，
             明示"正在干活"而不是无响应；文字与进度条都走主题画刷（暗色下不能继承黑字） -->
        <Grid Background="{DynamicResource B.Scrim}"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Focusable="False">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Border}"
                    BorderThickness="1" CornerRadius="8" Padding="30,22" MinWidth="400">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.45" />
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="{Binding ScanStatusText}" Foreground="{DynamicResource B.Text}"
                               FontSize="14" FontWeight="Bold" TextWrapping="Wrap" />
                    <ProgressBar Height="6" Margin="0,14,0,0" Minimum="0" Maximum="100" BorderThickness="0"
                                 Background="{DynamicResource B.BorderSoft}" Foreground="{DynamicResource B.Accent}"
                                 Value="{Binding ScanProgressValue}" IsIndeterminate="{Binding IsDetecting}" />
                    <TextBlock Text="{Binding ScanProgressDetail}" Foreground="{DynamicResource B.TextDim}"
                               Margin="0,9,0,0" FontSize="12" TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
