<Window x:Class="BSGroupGenerator.Wpf.Views.NewModsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.NewMods_Title}" Width="580" Height="600" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="{DynamicResource B.Window}"
        FontFamily="{StaticResource AppFont}" FontSize="13">
    <DockPanel>
        <TextBlock x:Name="TopLabel" DockPanel.Dock="Top" Margin="10,10,10,4" TextWrapping="Wrap"
                   Foreground="{DynamicResource B.Text}" />
        <StackPanel DockPanel.Dock="Bottom" Margin="10,4,10,10">
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="{DynamicResource L.NewMods_Target}" VerticalAlignment="Center" Margin="0,0,10,0"
                           Foreground="{DynamicResource B.Text}" />
                <ComboBox x:Name="GroupCombo" Width="260" Height="30"
                          DisplayMemberPath="Name" VerticalContentAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="SummaryLabel" Margin="0,4,0,0" Foreground="{DynamicResource B.TextDim}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="PresetsButton" Click="Presets_Click" MinWidth="140" MinHeight="28" Margin="0,0,8,0" />
                <Button Content="{DynamicResource L.Btn_Close}" IsCancel="True" MinWidth="84" MinHeight="28" Margin="0,0,8,0" />
                <Button Content="{DynamicResource L.NewMods_AddSelected}" Style="{StaticResource PrimaryButton}" Click="Apply_Click" MinWidth="110" />
            </StackPanel>
        </StackPanel>
        <TreeView x:Name="Tree" Margin="10,4,10,0">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
