<Window x:Class="BSGroupGenerator.Wpf.Views.GroupMembersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="680" MinWidth="500" MinHeight="420" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource B.Window}" FontFamily="{StaticResource AppFont}" FontSize="13"
        Style="{StaticResource AppWindow}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,4"
                    xmlns:ui="clr-namespace:BSGroupGenerator.Wpf.Services">
            <TextBox x:Name="FilterBox" Width="240" ui:Watermark.Text="{DynamicResource L.Members_FilterMembers}" />
            <TextBox x:Name="ModFilterBox" Width="240" Margin="10,0,0,0" ui:Watermark.Text="{DynamicResource L.Members_FilterMods}" />
        </StackPanel>
        <TextBlock x:Name="CountLabel" DockPanel.Dock="Bottom" Margin="10,4,10,4"
                   Foreground="{DynamicResource B.TextDim}" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="{DynamicResource L.Members_RemoveSelected}" Click="Remove_Click" MinWidth="100" MinHeight="28" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.Btn_Close}" IsCancel="True" MinWidth="84" MinHeight="28" />
        </StackPanel>
        <TreeView x:Name="Tree" Margin="10,4,10,0">
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}"
                                  VerticalAlignment="Center" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource B.Text}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMember}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource B.Member}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsConflict}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource B.Conflict}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource B.TextDim}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
        </TreeView>
    </DockPanel>
</Window>
