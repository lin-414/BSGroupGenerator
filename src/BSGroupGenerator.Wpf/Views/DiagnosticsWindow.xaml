<Window x:Class="BSGroupGenerator.Wpf.Views.DiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.Diag_Title}" Width="860" Height="560" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource B.Window}" FontFamily="{StaticResource AppFont}" FontSize="13"
        Style="{StaticResource AppWindow}">
    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="10">
            <Button Content="{DynamicResource L.Btn_CopyAll}" Click="Copy_Click" MinWidth="90" MinHeight="28" Margin="0,0,8,0" />
            <Button Content="{DynamicResource L.Btn_Close}" IsCancel="True" MinWidth="84" MinHeight="28" />
        </StackPanel>
        <TextBox x:Name="ReportBox" Margin="10,10,10,4" IsReadOnly="True" TextChanged="Report_Changed"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource MonoFont}" FontSize="12"
                 Background="{DynamicResource B.Panel}" BorderBrush="{DynamicResource B.Border}" />
    </DockPanel>
</Window>
