<Window x:Class="BSGroupGenerator.Wpf.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource L.About_Title}" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource B.Window}" FontFamily="{StaticResource AppFont}" FontSize="13"
        Style="{StaticResource AppWindow}">
    <StackPanel Margin="22,20,22,10">
        <StackPanel Orientation="Horizontal">
            <Image Source="../app.ico" Width="40" Height="40" Stretch="Uniform" />
            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="BS Group Generator" FontSize="18" FontWeight="Bold"
                           Foreground="{DynamicResource B.Text}" />
                <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource B.TextDim}" />
            </StackPanel>
        </StackPanel>
        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" Foreground="{DynamicResource B.Text}"
                   Text="{DynamicResource L.About_Desc}" />
        <TextBlock Margin="0,12,0,0" Foreground="{DynamicResource B.Text}">
            <Hyperlink Click="Repo_Click" Foreground="{DynamicResource B.AccentText}">
                GitHub：github.com/lin-414/BSGroupGenerator
            </Hyperlink>
        </TextBlock>
        <TextBlock Margin="0,8,0,0" Text="{DynamicResource L.About_Author}" Foreground="{DynamicResource B.Text}" />
        <TextBlock Margin="0,10,0,0" Foreground="{DynamicResource B.TextDim}" TextWrapping="Wrap"
                   Text="{DynamicResource L.About_Compat}" />
        <Button Content="{DynamicResource L.Btn_Ok}" IsDefault="True" IsCancel="True" Click="Ok_Click"
                MinWidth="90" MinHeight="30" Margin="0,16,0,6" HorizontalAlignment="Right" />
    </StackPanel>
</Window>
